{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaceGear Studio",
  "version": "0.1.0",
  "identifier": "com.facegear.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FaceGear Studio · 面齿轮设计与分析",
        "width": 1500,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
